{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Operation and Evidence Envelope v1",
  "description": "Versioned cross-service operation/evidence envelope. A valid shape does not itself prove authority, authenticity, execution, or revision binding.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "operation_id",
    "request_digest",
    "parent_operation_id",
    "parent_request_digest",
    "event_id",
    "stage",
    "decision_state",
    "producer",
    "observed_at",
    "action",
    "evidence_ref",
    "authority_ref"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "operation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "request_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "parent_operation_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "parent_request_digest": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{64}$"
    },
    "event_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "stage": {
      "enum": [
        "intent",
        "receipt",
        "reconciliation"
      ]
    },
    "decision_state": {
      "enum": [
        "pending",
        "completed",
        "indeterminate",
        "conflict",
        "denied"
      ]
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "commit_sha"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 3,
          "maxLength": 200,
          "pattern": "^[^/\\s]+/[^/\\s]+$"
        },
        "commit_sha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        }
      }
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "resource",
        "method"
      ],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "resource": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "method": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 32
        }
      }
    },
    "evidence_ref": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 2048,
      "minLength": 1
    },
    "authority_ref": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 512,
      "minLength": 1
    },
    "attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "key_id",
        "signature"
      ],
      "properties": {
        "algorithm": {
          "const": "Ed25519"
        },
        "key_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:-]+$"
        },
        "signature": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/]{86}==$"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "stage": {
            "const": "receipt"
          }
        },
        "required": [
          "stage"
        ]
      },
      "then": {
        "required": [
          "attestation"
        ]
      }
    }
  ]
}
